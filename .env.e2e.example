# Copy to .env.e2e.local (gitignored) to run `npm run test:e2e:auth`.
# The authenticated suite refuses any project ref not listed below.
# Use the dedicated PetroCore Supply E2E project, not the demo project.

E2E_SUPABASE_URL=https://<project-ref>.supabase.co
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_ALLOWED_PROJECT_REF=<project-ref>

E2E_ORG_ID=eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee
E2E_OWNER_EMAIL=e2e.owner@petrocore.test
E2E_VIEWER_EMAIL=e2e.viewer@petrocore.test
E2E_BASE_URL=http://127.0.0.1:3000
